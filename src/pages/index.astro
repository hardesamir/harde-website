---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Marquee from '../components/Marquee.astro';
import Letterbox from '../components/Letterbox.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import FilmReel from '../components/home/FilmReel.astro';
import FeaturedWorks from '../components/home/FeaturedWorks.astro';
import GalleryTeaser from '../components/home/GalleryTeaser.astro';
import Contact from '../components/home/Contact.astro';
import profile from '../data/profile.json';
import homepage from '../data/homepage.json';
import { resolveImage } from '../utils/images';

const [letterboxA, letterboxB] = homepage.letterboxes;
---

<Base
  title="Harde Samir Murshid — Actor & Director"
  description="Harde Samir Murshid is a Kurdish actor and director from Sulaymaniyah, bridging traditional theatre with contemporary cinema. Director of the award-winning short film “A Halla Way” (2020)."
>
  <Preloader />
  <Hero />
  <About />
  {letterboxA && (
    <Letterbox
      image={resolveImage(letterboxA.image)}
      alt="Cinematic still of Harde Samir Murshid"
      caption={letterboxA.caption}
    />
  )}
  <FilmReel />
  <Marquee items={['10 International Awards', '“A Halla Way”', 'Dir. 2020', profile.tagline]} />
  <FeaturedWorks />
  <GalleryTeaser />
  {letterboxB && (
    <Letterbox
      image={resolveImage(letterboxB.image)}
      alt="Behind the scenes still"
      caption={letterboxB.caption}
    />
  )}
  <Contact />
</Base>
