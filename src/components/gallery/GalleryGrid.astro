---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const allImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.jpg', { eager: true })
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

// full-size variants for the PhotoSwipe lightbox (needs intrinsic dimensions)
const items = await Promise.all(
  allImages.map(async (img) => {
    const full = await getImage({ src: img, width: Math.min(img.width, 1600), format: 'webp' });
    return { img, full };
  })
);

// round-robin into three columns; each column scrolls at its own parallax speed
const columns: (typeof items)[] = [[], [], []];
items.forEach((item, i) => columns[i % 3].push(item));
const speeds = [-40, 40, -70];
---

<div class="gallery-grid" id="pswp-gallery" data-gallery>
  {columns.map((column, ci) => (
    <div class="gallery-column" data-gallery-col data-speed={speeds[ci]}>
      {column.map(({ img, full }) => (
        <a
          href={full.src}
          data-pswp-width={full.attributes.width}
          data-pswp-height={full.attributes.height}
          target="_blank"
          rel="noreferrer"
          class="gallery-item"
          data-cursor="view"
        >
          <Image
            src={img}
            alt="Photography still of Harde Samir Murshid"
            widths={[420, 640, 900]}
            sizes="(max-width: 700px) 50vw, 33vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.2vw, 2rem);
    align-items: start;
  }

  .gallery-column {
    display: grid;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .gallery-column:nth-child(2) {
    padding-top: clamp(2rem, 6vw, 5rem);
  }

  .gallery-item {
    display: block;
    overflow: hidden;
    background: var(--bone-deep);
  }

  .gallery-item img {
    width: 100%;
    height: auto;
    filter: grayscale(15%);
    transition: transform 0.9s var(--ease-out), filter 0.5s var(--ease-out);
  }

  .gallery-item:hover img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  @media (max-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* third column folds away; its items redistribute via row flow */
    .gallery-grid {
      display: block;
      column-count: 2;
      column-gap: 1rem;
    }

    .gallery-column {
      display: contents;
    }

    .gallery-item {
      margin-bottom: 1rem;
      break-inside: avoid;
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  let lightbox: PhotoSwipeLightbox | null = null;

  function initLightbox() {
    if (!document.querySelector('#pswp-gallery')) return;
    lightbox = new PhotoSwipeLightbox({
      gallery: '#pswp-gallery',
      children: 'a.gallery-item',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.96,
    });
    lightbox.init();
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
  document.addEventListener('astro:before-swap', () => {
    lightbox?.destroy();
    lightbox = null;
  });
</script>
