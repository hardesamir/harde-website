---
import music from '../data/music.json';

const active = music.enabled && music.file;
---

{
  active && (
    <div class="music-player" transition:persist="music-player">
      <button
        class="music-toggle"
        aria-pressed="false"
        aria-label="Turn sound on"
        data-music-toggle
        data-src={music.file}
      >
        <span class="eq" aria-hidden="true">
          <i />
          <i />
          <i />
          <i />
        </span>
        <span class="mono-label">{music.label}</span>
      </button>
    </div>
  )
}

<style>
  .music-player {
    position: fixed;
    left: var(--gutter);
    bottom: 1.5rem;
    z-index: 9000;
  }

  .music-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(242, 238, 230, 0.82);
    color: var(--ink);
    backdrop-filter: blur(14px);
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .music-toggle:hover {
    border-color: var(--crimson);
    color: var(--crimson);
  }

  :global(html[data-theme='dark']) .music-toggle {
    background: rgba(19, 17, 16, 0.82);
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .eq i {
    width: 2px;
    height: 100%;
    background: var(--crimson);
    transform: scaleY(0.25);
    transform-origin: bottom;
    animation: eq-bounce 1.1s ease-in-out infinite;
    animation-play-state: paused;
  }

  .eq i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .eq i:nth-child(3) {
    animation-delay: 0.45s;
  }

  .eq i:nth-child(4) {
    animation-delay: 0.7s;
  }

  .music-toggle[aria-pressed='true'] .eq i {
    animation-play-state: running;
  }

  @keyframes eq-bounce {
    0%,
    100% {
      transform: scaleY(0.25);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (max-width: 768px) {
    .music-player {
      bottom: 1rem;
    }
  }
</style>

<script>
  // module scope survives Astro view transitions, so playback never restarts
  let audio: HTMLAudioElement | null = null;
  let fadeFrame = 0;
  let armed = false;
  const TARGET_VOLUME = 0.35;
  const PREF_KEY = 'hs-sound';

  function pref(): string | null {
    try {
      return localStorage.getItem(PREF_KEY);
    } catch {
      return null;
    }
  }

  function setPref(value: string) {
    try {
      localStorage.setItem(PREF_KEY, value);
    } catch {}
  }

  function fadeTo(target: number, onDone?: () => void) {
    if (!audio) return;
    cancelAnimationFrame(fadeFrame);
    const start = audio.volume;
    const t0 = performance.now();
    const step = (t: number) => {
      if (!audio) return;
      const p = Math.min((t - t0) / 600, 1);
      audio.volume = start + (target - start) * p;
      if (p < 1) fadeFrame = requestAnimationFrame(step);
      else onDone?.();
    };
    fadeFrame = requestAnimationFrame(step);
  }

  function setUi(btn: HTMLButtonElement, playing: boolean) {
    btn.setAttribute('aria-pressed', String(playing));
    btn.setAttribute('aria-label', playing ? 'Turn sound off' : 'Turn sound on');
  }

  function ensureAudio(src: string | undefined) {
    if (!audio) {
      audio = new Audio(src);
      audio.loop = true;
      audio.volume = 0;
    }
    return audio;
  }

  function currentBtn() {
    return document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  }

  function begin() {
    if (!audio) return;
    audio
      .play()
      .then(() => {
        fadeTo(TARGET_VOLUME);
        const btn = currentBtn();
        if (btn) setUi(btn, true);
      })
      .catch(() => {});
  }

  // autoplay was blocked: start at the visitor's first real interaction anywhere
  function armFirstInteraction(src: string | undefined) {
    if (armed) return;
    armed = true;
    const events = ['pointerdown', 'keydown', 'touchend'];
    const disarm = () => {
      events.forEach((ev) => window.removeEventListener(ev, onFirst, true));
      armed = false;
    };
    const onFirst = (e: Event) => {
      disarm();
      // let the toggle's own click handler decide instead of racing it
      if ((e.target as HTMLElement | null)?.closest?.('[data-music-toggle]')) return;
      if (pref() === 'off') return;
      ensureAudio(src);
      begin();
    };
    events.forEach((ev) => window.addEventListener(ev, onFirst, true));
  }

  function bind() {
    const btn = currentBtn();
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';

    // reflect a still-playing track after a page transition re-renders the button
    setUi(btn, !!audio && !audio.paused);

    btn.addEventListener('click', () => {
      ensureAudio(btn.dataset.src);
      if (!audio) return;
      if (audio.paused) {
        setPref('on');
        begin();
      } else {
        fadeTo(0, () => audio?.pause());
        setUi(btn, false);
        setPref('off');
      }
    });

    // auto-start unless the visitor previously turned the sound off
    if (pref() !== 'off' && (!audio || audio.paused)) {
      ensureAudio(btn.dataset.src);
      audio!
        .play()
        .then(() => {
          fadeTo(TARGET_VOLUME);
          setUi(btn, true);
        })
        .catch(() => armFirstInteraction(btn.dataset.src));
    }
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
