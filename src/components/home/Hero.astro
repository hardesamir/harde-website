---
import { Image } from 'astro:assets';
import profile from '../../data/profile.json';
import heroImage from '../../assets/hero/hero-background2.jpg';
---

<section class="hero theme-ink" id="home" data-hero>
  <div class="hero-bg" data-hero-bg>
    <Image
      src={heroImage}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container hero-content">
    <p class="mono-label hero-slate" data-hero-slate>
      Scene 01 <span class="slate-sep">/</span> {profile.location}
    </p>

    <h1 class="display-xl hero-name" data-hero-name>
      {profile.name.split(' ').map((word) => (
        <span class="hero-word">{word}</span>
      ))}
    </h1>

    <div class="hero-sub" data-hero-sub>
      <p class="caps-label hero-role">{profile.roles.join(' — ').toUpperCase()}</p>
      <p class="lede hero-desc">{profile.heroDescription}</p>
      <div class="hero-ctas">
        <a href="/gallery/" class="btn">View Gallery <span class="arrow">→</span></a>
        <a href="/#works" class="btn">Selected Works <span class="arrow">→</span></a>
      </div>
    </div>
  </div>

  <div class="hero-scroll mono-label" data-hero-scroll aria-hidden="true">
    <span>Scroll</span>
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(6rem, 12vh, 9rem) clamp(4rem, 9vh, 7rem);
    overflow: clip;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.5;
    filter: grayscale(35%) contrast(1.05);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(18, 16, 14, 0.55) 0%, rgba(18, 16, 14, 0.15) 45%, rgba(18, 16, 14, 0.88) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-slate {
    color: rgba(242, 238, 230, 0.75);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .slate-sep {
    color: var(--crimson);
  }

  .hero-name {
    text-transform: uppercase;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    max-width: 14ch;
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.22em;
  }

  .hero-sub {
    display: grid;
    gap: 1.5rem;
    max-width: 620px;
  }

  .hero-role {
    color: var(--crimson);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(4rem, 9vh, 7rem);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    color: rgba(242, 238, 230, 0.65);
    writing-mode: vertical-rl;
  }

  .scroll-line {
    width: 1px;
    height: 64px;
    background: linear-gradient(to bottom, var(--crimson), transparent);
    animation: scroll-pulse 2.2s var(--ease-cine) infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (max-width: 768px) {
    .hero-scroll {
      display: none;
    }
  }
</style>
