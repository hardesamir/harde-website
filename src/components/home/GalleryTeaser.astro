---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '../SectionLabel.astro';

const allImages = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.jpg', { eager: true })
).map((m) => m.default);

const teaser = allImages.slice(0, 4);
const total = allImages.length;
---

<section class="section gallery-teaser" id="gallery-teaser">
  <div class="container">
    <SectionLabel num="05" label="Gallery" />

    <div class="teaser-head">
      <h2 class="display-lg" data-split>Stills &amp; moments.</h2>
      <a href="/gallery/" class="btn" data-reveal="rise">
        All {total} photos <span class="arrow">→</span>
      </a>
    </div>

    <div class="teaser-grid">
      {teaser.map((img, i) => (
        <a href="/gallery/" class="teaser-item" data-cursor="view" data-reveal="wipe" style={`--i: ${i}`}>
          <Image
            src={img}
            alt="Photography still from the gallery"
            widths={[420, 640]}
            sizes="(max-width: 700px) 50vw, 25vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .teaser-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .teaser-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }

  .teaser-item {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--bone-deep);
  }

  .teaser-item:nth-child(even) {
    translate: 0 clamp(1rem, 3vw, 2.5rem);
  }

  .teaser-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(25%);
    transition: transform 0.9s var(--ease-out), filter 0.6s var(--ease-out);
  }

  .teaser-item:hover img {
    transform: scale(1.05);
    filter: grayscale(0%);
  }

  @media (max-width: 700px) {
    .teaser-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
