---
import profile from '../data/profile.json';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#filmography', label: 'Filmography' },
  { href: '/#works', label: 'Works' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="wordmark" transition:name="wordmark">
      {profile.shortName}
      <span class="wordmark-dot">.</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" data-nav-toggle>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav-overlay" data-nav-overlay>
    <nav aria-label="Mobile navigation">
      {links.map((l, i) => (
        <a href={l.href} style={`--i: ${i}`}>
          <span class="mono-label overlay-num">0{i + 1}</span>
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9000;
    padding-block: 1.1rem;
    transition: background-color 0.4s var(--ease-out), backdrop-filter 0.4s var(--ease-out);
  }

  .site-nav.scrolled {
    background: rgba(242, 238, 230, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .site-nav.on-ink:not(.scrolled) {
    color: var(--bone);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .wordmark-dot {
    color: var(--crimson);
  }

  .nav-links {
    display: flex;
    gap: 2.25rem;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 7px;
    padding: 8px 4px;
    z-index: 2;
  }

  .nav-toggle span {
    display: block;
    width: 28px;
    height: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out), opacity 0.35s;
  }

  .nav-overlay {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: var(--ink);
      color: var(--bone);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease-cine);
    }

    .nav-overlay nav {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.5rem;
      padding-inline: var(--gutter);
    }

    .nav-overlay a {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 9vw, 3.5rem);
      line-height: 1.25;
      display: flex;
      align-items: baseline;
      gap: 1rem;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
      transition-delay: calc(0.06s * var(--i));
    }

    .overlay-num {
      color: var(--crimson);
    }

    .site-nav.menu-open .nav-overlay {
      opacity: 1;
      pointer-events: auto;
    }

    .site-nav.menu-open .nav-overlay a {
      opacity: 1;
      transform: none;
    }

    .site-nav.menu-open {
      color: var(--bone);
    }

    .site-nav.menu-open .nav-toggle span:first-child {
      transform: translateY(4.5px) rotate(45deg);
    }

    .site-nav.menu-open .nav-toggle span:last-child {
      transform: translateY(-4.5px) rotate(-45deg);
    }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector('[data-nav]');
    const toggle = document.querySelector('[data-nav-toggle]');
    if (!nav || !toggle) return;

    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });

    nav.querySelectorAll('.nav-overlay a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.remove('menu-open');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
