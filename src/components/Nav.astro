---
import profile from '../data/profile.json';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#filmography', label: 'Filmography' },
  { href: '/#works', label: 'Works' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="wordmark" transition:name="wordmark">
      {profile.shortName}
      <span class="wordmark-dot">.</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <button class="theme-toggle" aria-label="Switch to dark theme" data-theme-toggle>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>

      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" data-nav-toggle>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="nav-overlay" data-nav-overlay>
    <nav aria-label="Mobile navigation">
      {links.map((l, i) => (
        <a href={l.href} style={`--i: ${i}`}>
          <span class="mono-label overlay-num">0{i + 1}</span>
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9000;
    padding-block: 1.1rem;
    transition: background-color 0.4s var(--ease-out), backdrop-filter 0.4s var(--ease-out);
  }

  .site-nav.scrolled {
    background: rgba(242, 238, 230, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  :global(html[data-theme='dark']) .site-nav.scrolled {
    background: rgba(19, 17, 16, 0.82);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--crimson);
    color: var(--crimson);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }

  .icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }

  .site-nav.on-ink:not(.scrolled) {
    color: var(--bone);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .wordmark-dot {
    color: var(--crimson);
  }

  .nav-links {
    display: flex;
    gap: 2.25rem;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1px;
    background: var(--crimson);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 7px;
    padding: 8px 4px;
    z-index: 2;
  }

  .nav-toggle span {
    display: block;
    width: 28px;
    height: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out), opacity 0.35s;
  }

  .nav-overlay {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-overlay {
      display: block;
      position: fixed;
      inset: 0;
      /* menu overlay stays ink in both themes */
      background: #12100e;
      color: #f2eee6;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease-cine);
    }

    .nav-overlay nav {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.5rem;
      padding-inline: var(--gutter);
    }

    .nav-overlay a {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 9vw, 3.5rem);
      line-height: 1.25;
      display: flex;
      align-items: baseline;
      gap: 1rem;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
      transition-delay: calc(0.06s * var(--i));
    }

    .overlay-num {
      color: var(--crimson);
    }

    .site-nav.menu-open .nav-overlay {
      opacity: 1;
      pointer-events: auto;
    }

    .site-nav.menu-open .nav-overlay a {
      opacity: 1;
      transform: none;
    }

    .site-nav.menu-open {
      color: var(--bone);
    }

    .site-nav.menu-open .nav-toggle span:first-child {
      transform: translateY(4.5px) rotate(45deg);
    }

    .site-nav.menu-open .nav-toggle span:last-child {
      transform: translateY(-4.5px) rotate(-45deg);
    }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const toggle = document.querySelector('[data-nav-toggle]');
    if (!nav || !toggle) return;

    nav.classList.toggle('scrolled', window.scrollY > 40);
    // one window-level scroll listener that always targets the current nav
    if (!(window as any).__navScrollBound) {
      (window as any).__navScrollBound = true;
      window.addEventListener(
        'scroll',
        () => document.querySelector('[data-nav]')?.classList.toggle('scrolled', window.scrollY > 40),
        { passive: true }
      );
    }

    // guard: initNav runs both at module load and on astro:page-load —
    // double-binding the toggle makes the menu open and instantly close
    if (nav.dataset.bound) return;
    nav.dataset.bound = '1';

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });

    nav.querySelectorAll('.nav-overlay a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.remove('menu-open');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );

    const themeBtn = document.querySelector('[data-theme-toggle]');
    if (themeBtn && !(themeBtn as HTMLElement).dataset.bound) {
      (themeBtn as HTMLElement).dataset.bound = '1';
      const syncLabel = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeBtn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      };
      syncLabel();
      themeBtn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('hs-theme', next);
        } catch {}
        (window as any).__applyTheme?.(next);
        syncLabel();
      });
    }
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
